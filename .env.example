# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://sjh_db_user:<db_password>@cluster0.z4yqo6.mongodb.net/?appName=Cluster0
MONGO_PASSWORD=
ATLAS_DB=shibboleth
ATLAS_VOICE_INDEX=voiceprints_vec

# ---- Embeddings ----
# Working now via OpenRouter (verified 200). To switch to Atlas/Voyage, set
# EMBED_API_KEY to a Voyage key and use the three commented lines instead.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=<your-openrouter-key>
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
# EMBED_BASE_URL=https://ai.mongodb.com/v1
# EMBED_MODEL=voyage-3.5-lite
# EMBED_DIM=1024

# ---- LLM ----
OPENROUTER_API_KEY=<your-openrouter-key>
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Voice (Jabir) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

TAU_ID=0.85
TAU_REJECT=0.05
MAX_QUESTIONS=5
VOICE_TOPK=8
